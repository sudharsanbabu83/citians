{
  "name": "@campusflow/functions",
  "version": "1.0.0",
  "private": true,
  "main": "lib/index.js",
  "scripts": {
    "build": "node scripts/sync-vendor-shared.mjs && tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "bootstrap:admin": "ts-node scripts/bootstrap-prod-admin.ts"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@campusflow/shared": "file:./vendor/shared",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^7.3.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
