{
  "name": "@campusflow/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node scripts/start-expo.mjs start --clear --go",
    "start:offline": "node scripts/start-expo.mjs start --clear --go --offline",
    "start:dev-client": "node scripts/start-expo.mjs start --clear --dev-client",
    "start:prod": "node scripts/start-expo.mjs start --clear --dev-client",
    "android": "node scripts/start-expo.mjs start --android --clear --go",
    "ios": "node scripts/start-expo.mjs start --ios --clear --go",
    "clear:expo-cache": "node scripts/clear-expo-cache.mjs",
    "run:android": "expo run:android",
    "run:ios": "expo run:ios",
    "build:preview": "node scripts/check-eas-build.mjs android && eas build --profile preview --platform android",
    "build:production": "node scripts/check-eas-build.mjs android && eas build --profile production --platform android",
    "build:preview:ios": "node scripts/check-eas-build.mjs ios && eas build --profile preview --platform ios",
    "build:preview:local": "node scripts/check-eas-build.mjs android && eas build --profile preview --platform android --local",
    "build:preview:ios:local": "node scripts/check-eas-build.mjs ios && eas build --profile preview --platform ios --local",
    "build:development:ios": "node scripts/check-eas-build.mjs ios && eas build --profile development --platform ios",
    "web": "expo start --web --clear",
    "typecheck": "tsc --noEmit",
    "eas-build-post-install": "npm run build:shared --prefix ../.."
  },
  "dependencies": {
    "@campusflow/shared": "*",
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^3.10.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/native": "^7.0.14",
    "@tanstack/react-query": "^5.64.2",
    "expo": "~54.0.37",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-web-browser": "~15.0.11",
    "firebase": "^11.2.0",
    "pdf-lib": "^1.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.54.2",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~54.0.12",
    "typescript": "~5.9.2"
  }
}
