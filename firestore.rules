rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper functions
    // -------------------------------------------------------------------------

    function isAuth() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return isAuth() && userDoc().isActive == true;
    }

    function userRole() {
      return userDoc().role;
    }

    function isAdmin() {
      return isActiveUser() && userRole() == 'ADMIN';
    }

    function isHod() {
      return isActiveUser() && userRole() == 'HOD';
    }

    function isStudent() {
      return isActiveUser() && userRole() == 'STUDENT';
    }

    function hodDepartmentId() {
      return get(/databases/$(database)/documents/hods/$(request.auth.uid)).data.departmentId;
    }

    function isStudentInHodDepartment(userId) {
      return isHod() &&
        exists(/databases/$(database)/documents/students/$(userId)) &&
        get(/databases/$(database)/documents/students/$(userId)).data.departmentId == hodDepartmentId();
    }

    function studentProfile() {
      return get(/databases/$(database)/documents/students/$(request.auth.uid)).data;
    }

    function isOwnerStudentUserId(studentUserId) {
      return isAuth() && request.auth.uid == studentUserId;
    }

    function isDraftStatus(status) {
      return status == 'DRAFT';
    }

    function isForbiddenStatusTransition() {
      return request.resource.data.status in ['APPROVED', 'REJECTED', 'REVOKED', 'PENDING_HOD_REVIEW', 'CHANGES_REQUESTED'];
    }

    // -------------------------------------------------------------------------
    // users
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isAuth() && (
        request.auth.uid == userId ||
        isAdmin() ||
        isStudentInHodDepartment(userId)
      );
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isAuth() &&
        request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.isActive == resource.data.isActive
      );
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // students
    // -------------------------------------------------------------------------
    match /students/{studentId} {
      allow read: if isAdmin() || (
        isAuth() && (
          request.auth.uid == resource.data.userId ||
          (isHod() && resource.data.departmentId == hodDepartmentId())
        )
      );
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // hods
    // -------------------------------------------------------------------------
    match /hods/{hodId} {
      allow read: if isAdmin() || (isAuth() && request.auth.uid == resource.data.userId);
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // departments
    // -------------------------------------------------------------------------
    match /departments/{departmentId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // odRequests
    // -------------------------------------------------------------------------
    match /odRequests/{requestId} {
      allow read: if isAdmin() || (
        isAuth() && (
          resource.data.studentUserId == request.auth.uid ||
          (isHod() && resource.data.departmentId == hodDepartmentId())
        )
      );

      allow create: if isStudent() &&
        request.resource.data.studentUserId == request.auth.uid &&
        request.resource.data.status == 'DRAFT';

      allow update: if isAdmin() || (
        isStudent() &&
        resource.data.studentUserId == request.auth.uid &&
        resource.data.status in ['DRAFT', 'CHANGES_REQUESTED'] &&
        request.resource.data.studentUserId == resource.data.studentUserId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hodUserId', 'departmentId']) ||
        (request.resource.data.status == 'DRAFT' && resource.data.status == 'DRAFT')
      ) && !(
        isStudent() && request.resource.data.status in ['APPROVED', 'REJECTED', 'REVOKED', 'PENDING_HOD_REVIEW']
      );

      allow delete: if isAdmin() || (
        isStudent() &&
        resource.data.studentUserId == request.auth.uid &&
        resource.data.status == 'DRAFT'
      );

      match /documents/{documentId} {
        allow read: if isAdmin() || (
          isAuth() && (
            get(/databases/$(database)/documents/odRequests/$(requestId)).data.studentUserId == request.auth.uid ||
            (isHod() && get(/databases/$(database)/documents/odRequests/$(requestId)).data.departmentId == hodDepartmentId())
          )
        );
        allow create, update: if isStudent() &&
          get(/databases/$(database)/documents/odRequests/$(requestId)).data.studentUserId == request.auth.uid &&
          get(/databases/$(database)/documents/odRequests/$(requestId)).data.status in ['DRAFT', 'CHANGES_REQUESTED'];
        allow delete: if isAdmin() || (
          isStudent() &&
          get(/databases/$(database)/documents/odRequests/$(requestId)).data.studentUserId == request.auth.uid &&
          get(/databases/$(database)/documents/odRequests/$(requestId)).data.status in ['DRAFT', 'CHANGES_REQUESTED']
        );
      }
    }

    // -------------------------------------------------------------------------
    // odPasses — no client writes
    // -------------------------------------------------------------------------
    match /odPasses/{passId} {
      allow read: if isAdmin() || (
        isAuth() && (
          resource.data.studentUserId == request.auth.uid ||
          (isHod() && resource.data.departmentId == hodDepartmentId())
        )
      );
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // notifications
    // -------------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow update: if isAuth() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) &&
        request.resource.data.isRead == true;
      allow create, delete: if false;
    }

    // -------------------------------------------------------------------------
    // deviceTokens
    // -------------------------------------------------------------------------
    match /deviceTokens/{tokenId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // auditLogs — admin read only, no client writes
    // -------------------------------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // odPassSecrets — server-only via Cloud Functions
    // -------------------------------------------------------------------------
    match /odPassSecrets/{passId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // verificationLogs — admin read only, no client writes
    // -------------------------------------------------------------------------
    match /verificationLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
